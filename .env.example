# ============================================================
# Kieran's LifeTrkr — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to the repo. It is in .gitignore.
# ============================================================


# ------------------------------------------------------------
# VITE_GOOGLE_CLIENT_ID
# The only value required to enable Google Calendar + Tasks sync.
# This is a PUBLIC value — safe to embed in client-side code.
# It is NOT a secret. Do not confuse with GOOGLE_CLIENT_SECRET.
#
# Get it from: https://console.cloud.google.com
#   → APIs & Services → Credentials → OAuth 2.0 Client ID
#   → Application type: Web application
#   → Add your Replit dev URL and https://okhp3.github.io
#     to Authorized JavaScript Origins
# ------------------------------------------------------------
VITE_GOOGLE_CLIENT_ID=

# ------------------------------------------------------------
# NOTES
# - Phase 1 (current): No env vars required. App runs fully on localStorage.
# - Phase 1.5+: Set VITE_GOOGLE_CLIENT_ID to enable Google sync.
# - Phase 2 (planned): Notion backend vars will be added here.
# - Store in Replit Secrets panel for deployment — never commit.
# ------------------------------------------------------------
