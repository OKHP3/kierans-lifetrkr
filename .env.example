# ============================================================
# Kieran's LifeTrkr — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to the repo. It is in .gitignore.
# In production, store all values in Replit's Secrets panel.
# ============================================================


# ------------------------------------------------------------
# PHASE 1 — localStorage only
# No environment variables required for Phase 1.
# ------------------------------------------------------------


# ------------------------------------------------------------
# PHASE 1.5 — Google Calendar (read-only OAuth)
# Set up at: https://console.cloud.google.com
# Project: "Kieran LifeTrkr"
# API: Google Calendar API (read-only)
# Credentials type: OAuth 2.0 Web Application
# ------------------------------------------------------------

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Your Replit deployment URL + /api/google/callback
# Add BOTH of these to GCP authorized redirect URIs:
#   http://localhost:3001/api/google/callback
#   https://[repl-name].[username].repl.co/api/google/callback
GOOGLE_REDIRECT_URI=

# Random 32-character string — used to sign the OAuth session cookie
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=


# ------------------------------------------------------------
# PHASE 2 — Notion Backend
# Create at: https://www.notion.so/my-integrations
# Integration name: "Kieran LifeTrkr Dev"
# Share each database with the integration after creating it.
# Database IDs are the 32-char hex string in the database URL.
# ------------------------------------------------------------

NOTION_API_KEY=

NOTION_ROUTINE_TEMPLATES_DB_ID=
NOTION_ROUTINE_COMPLETIONS_DB_ID=
NOTION_HABITS_DB_ID=
NOTION_HABIT_COMPLETIONS_DB_ID=
NOTION_TASKS_DB_ID=


# ------------------------------------------------------------
# NOTES
# - GOOGLE_* and SESSION_SECRET are required together in Phase 1.5
# - NOTION_* variables are required together in Phase 2
# - All values go in Replit Secrets panel for deployment
# - Rotate NOTION_API_KEY when transferring ownership to Kieran
# ------------------------------------------------------------
