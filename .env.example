# ============================================================
# Kieran's LifeTrkr — Environment Variables
# ============================================================
# Copy to .env for local development.
# In Replit, add each value to the Secrets panel (padlock icon).
# NEVER commit .env to this repo — it is in .gitignore.
# ============================================================


# ── Google OAuth (required for v0.2.0) ──────────────────────
# OAuth 2.0 Client ID from Google Cloud Console.
# This is NOT a secret — it is safe to embed in client-side code.
# It is designed to be public. Only the Client Secret is sensitive,
# and we do not use a Client Secret in this architecture.
#
# Setup:
#   1. console.cloud.google.com → New Project → "LifeTrkr"
#   2. Enable: Google Calendar API, Google Tasks API
#   3. Credentials → Create OAuth 2.0 Client ID (Web Application)
#   4. Authorized JavaScript Origins:
#      - https://okhp3.github.io
#      - http://localhost:5173
#   5. Copy the Client ID below. Ignore the Client Secret.
#
VITE_GOOGLE_CLIENT_ID=


# ── Cloudflare Worker (optional Claude wording) ──────────────────
# URL of the deployed LifeTrkr Oracle Worker. The Worker holds the
# Anthropic API key server-side. The browser never receives that key.
#
# Deploy from Cloudflare dashboard:
#   1. Workers & Pages → Create Worker → "lifetrkr-oracle"
#   2. Paste code from docs/PRD-v4.0.md Section C0
#   3. Settings → Variables → Add Secret: ANTHROPIC_API_KEY
#   4. Deploy → copy the worker URL below
#
VITE_ORACLE_WORKER_URL=


# ============================================================
# What is NOT needed:
# ============================================================
# - No NOTION_API_KEY (Notion is not the app database)
# - No GOOGLE_CLIENT_SECRET (token model — no secret required)
# - No SESSION_SECRET (no server, no sessions)
# - No EXPRESS_PORT (no backend server)
# - No database connection strings (localStorage only)
# ============================================================
