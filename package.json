{
  "name": "kieran-lifetrkr",
  "version": "0.1.10",
  "description": "Kieran's LifeTrkr — Personal Life OS",
  "private": true,
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/prepare-service-worker.mjs",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "audit:technology": "node scripts/technology-audit.mjs",
    "test:technology": "node --test scripts/technology-audit.test.mjs",
    "check:a11y": "node scripts/accessibility-check.mjs",
    "release:check": "node scripts/inspect-artifact.mjs",
    "test:sync": "node --test scripts/sync-regression.test.mjs",
    "test:service-worker": "node --test scripts/service-worker-regression.test.mjs",
    "test:date": "bun test scripts/date-regression.test.ts",
    "test:evening-wrap-up": "bun test scripts/evening-wrap-up-regression.test.ts",
    "test:evening-wrap-up-browser": "node scripts/evening-wrap-up-browser-regression.mjs",
    "test:settings-timezone": "bun test scripts/settings-timezone-regression.test.ts",
    "test:account-isolation": "bun test scripts/account-isolation-regression.test.ts",
    "test:scope": "bun test scripts/scope-regression.test.ts",
    "test:rituals-browser": "node scripts/rituals-browser-regression.mjs",
    "test:habits-browser": "node scripts/habits-browser-regression.mjs",
    "test:calendar-browser": "node scripts/calendar-browser-regression.mjs",
    "test:storage-warning-browser": "node scripts/storage-warning-browser-regression.mjs",
    "sync": "node scripts/run-sync.mjs",
    "deploy": "npm run build"
  },
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
